<%- include("../partials/header") %>

<section class="auth-shell">
  <div class="auth-copy">
    <span class="eyebrow">Team workspace</span>
    <h1>Plan work, assign clearly, ship on time.</h1>
    <p>Track projects, tasks, owners, due dates, and delivery status from one clean dashboard.</p>
  </div>
  <div class="auth-panel">
    <h1>Login</h1>
    <% if (error) { %>
      <p class="alert"><%= error %></p>
    <% } %>
    <form action="/auth/login" method="post" class="form-stack">
      <label>
        Email
        <input type="email" name="email" value="<%= form.email || "" %>" required>
      </label>
      <label>
        Password
        <input type="password" name="password" required>
      </label>
      <button type="submit">Login</button>
    </form>
    <p class="muted">No account? <a href="/auth/signup">Create one</a>.</p>
  </div>
</section>

<%- include("../partials/footer") %>
